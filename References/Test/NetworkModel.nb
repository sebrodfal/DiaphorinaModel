Cell[BoxData[
 RowBox[{"NDSolve", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"x1", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"x1", "[", "t", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"r1", "+", 
          RowBox[{"b12", "*", 
           RowBox[{"x2", "[", "t", "]"}]}], "+", 
          RowBox[{"b13", "*", 
           RowBox[{"x3", "[", "t", "]"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a1", "+", 
             RowBox[{"c1", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"b12", "*", 
                 RowBox[{"x2", "[", "t", "]"}]}], "+", 
                RowBox[{"b13", "*", 
                 RowBox[{"x3", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], "*", 
           RowBox[{"x1", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], ",", " ", 
