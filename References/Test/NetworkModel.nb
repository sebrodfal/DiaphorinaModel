Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SystemEvolve", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "SystemEvolve", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<LabelPosition\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"0.88", ",", "0.85"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SystemEvolve", "[", 
   RowBox[{"\[Delta]_", ",", "T_", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r1_", ",", "b12_", ",", "b13_", ",", "a1_", ",", "c1_"}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"r2_", ",", "b21_", ",", "b24_", ",", "a2_", ",", "c2_"}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"r3_", ",", "b31_", ",", "a3_", ",", "c3_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"r4_", ",", "b42_", ",", "a4_", ",", "c4_"}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Di0_", ",", "B0_", ",", "x30_", ",", "x40_", ",", "tt_"}], 
     "}"}], ",", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\n", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "eqs", ",", "x1", ",", "x2", ",", "x3", ",", "x4"}], 
     "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"eqs", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"x1", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"x1", "[", "t", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"r1", "+", 
               RowBox[{"b12", "*", 
                RowBox[{"x2", "[", "t", "]"}]}], "+", 
               RowBox[{"b13", "*", 
                RowBox[{"x3", "[", "t", "]"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"a1", "+", 
                  RowBox[{"c1", "*", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"b12", "*", 
                    RowBox[{"x2", "[", "t", "]"}]}], "+", 
                    RowBox[{"b13", "*", 
                    RowBox[{"x3", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], "*", 
                RowBox[{"x1", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], ",", " ", 
          RowBox[{"(*", 
           RowBox[{"Diaphorina", " ", "citri"}], "*)"}], "\n", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"x2", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"x2", "[", "t", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"r2", "+", 
               RowBox[{"b21", "*", 
                RowBox[{"x1", "[", "t", "]"}]}], "+", 
               RowBox[{"b24", "*", 
                RowBox[{"x4", "[", "t", "]"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"a2", "+", 
                  RowBox[{"c2", "*", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"b21", "*", 
                    RowBox[{"x1", "[", "t", "]"}]}], "+", 
                    RowBox[{"b24", "*", 
                    RowBox[{"x4", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], "*", 
                RowBox[{"x2", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], ",", " ", 
          RowBox[{"(*", 
           RowBox[{"Plant", " ", "shoots"}], "*)"}], "\n", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"x3", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"x3", "[", "t", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"r3", "+", 
               RowBox[{"b31", "*", 
                RowBox[{"x1", "[", "t", "]"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"a3", "+", 
                  RowBox[{"c3", "*", "b31", "*", 
                   RowBox[{"x1", "[", "t", "]"}]}]}], ")"}], "*", 
                RowBox[{"x3", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], ",", " ", 
          RowBox[{"(*", 
           RowBox[{"Tamarixia", " ", "radiata"}], "*)"}], "\n", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"x4", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"x4", "[", "t", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"r4", "+", 
               RowBox[{"b42", "*", 
                RowBox[{"x2", "[", "t", "]"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"a4", "+", 
                  RowBox[{"c4", "*", "b42", "*", 
                   RowBox[{"x2", "[", "t", "]"}]}]}], ")"}], "*", 
                RowBox[{"x4", "[", "t", "]"}]}]}], ")"}]}]}], ")"}], ",", " ", 
          RowBox[{"(*", "Stimuli", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x1", "[", "0", "]"}], "==", "Di0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x2", "[", "0", "]"}], "==", "B0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x3", "[", "0", "]"}], "==", "x30"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x4", "[", "0", "]"}], "==", "x40"}], ",", "\n", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{"t", ",", "T"}], "]"}], "==", "0"}], " ", "&&", " ", 
             RowBox[{"t", ">", "0"}]}], ",", " ", 
            RowBox[{
             RowBox[{"x3", "[", "t", "]"}], "->", 
             RowBox[{
              RowBox[{"x3", "[", "t", "]"}], "+", "\[Delta]"}]}]}], "]"}]}], 
         "\n", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "tt"}], "}"}], ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          
          RowBox[{"\"\<TimeIntegration\>\"", 
           "\[Rule]", "\"\<ExplicitRungeKutta\>\""}], "}"}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x1", "[", "t", "]"}], ",", 
           RowBox[{"x2", "[", "t", "]"}], ",", 
           RowBox[{"x3", "[", "t", "]"}], ",", 
           RowBox[{"x4", "[", "t", "]"}]}], "}"}], "/.", "eqs"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tt"}], "}"}], ",", "\n", "\t", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<Diaphorina citri\>\"", ",", "\"\<Plant shoots\>\"", 
            ",", "\"\<Tamarixia radiata\>\"", ",", "\"\<Stimuli\>\""}], "}"}],
           ",", 
          RowBox[{"OptionValue", "[", "\"\<LabelPosition\>\"", "]"}]}], 
         "]"}]}], ",", "\n", "\t", 
       RowBox[{"PlotRange", "->", "All"}], ",", " ", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["\"\<time (a.u.)\>\"", "Input"], ",", 
          " ", "\"\<population\>\""}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"GridLinesStyle", "\[Rule]", 
        RowBox[{"Directive", "[", "Dashed", "]"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "\n", 
   "]"}]}]}], "Code",
