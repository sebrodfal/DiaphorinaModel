              RowBox[{"{", 
               
               RowBox[{"\"\<r2\>\"", ",", "\"\<b21\>\"", ",", "\"\<b24\>\"", 
                ",", "\"\<a2\>\"", ",", "\"\<c2\>\""}], "}"}], "->", 
              "param2"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<x3\>\"", "->", 
           RowBox[{"Association", "@", 
