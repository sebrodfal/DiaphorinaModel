Cell[BoxData[
 RowBox[{
  RowBox[{"ChartReport", "[", 
   RowBox[{
   "init_", ",", "param1_", ",", "param2_", ",", "param3_", ",", "param4_"}], 
   "]"}], ":=", 
  RowBox[{"Transpose", "@", 
