     RowBox[{"Normal", "[", 
      RowBox[{"Dataset", "/@", 
       RowBox[{"Association", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<init\>\"", "->", 
           RowBox[{"Association", "@", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"{", 
               
               RowBox[{"\"\<x1[0]\>\"", ",", "\"\<x2[0]\>\"", 
                ",", "\"\<x3[0]\>\"", ",", "\"\<x4[0]\>\"", 
                ",", "\"\<t\>\""}], "}"}], "->", "init"}], "]"}]}]}], "}"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\"\<x1\>\"", "->", 
           RowBox[{"Association", "@", 
